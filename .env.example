# Required for live authentication. Copy to .env.local and restart Expo.
# Without these, auth screens are viewable but submissions are disabled.
# EXPO_PUBLIC values are embedded in the app: NEVER use a secret/service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep false until the classify-capture Edge Function is deployed and tested.
EXPO_PUBLIC_CAPTURE_AI_ENABLED=false
